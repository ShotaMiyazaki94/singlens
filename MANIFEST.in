include NOTICE
include logo_transparent.png
include CHANGELOG.md
recursive-include LICENSES *.txt
include .readthedocs.yaml
recursive-include docs *.md *.rst *.json *.py *.ipynb *.css *.png *.svg
prune docs/_build
prune docs/_autoapi
prune docs/reference
prune docs/.jupyter_cache
prune docs/.mplconfig
prune docs/local
recursive-include example *.py *.cpp *.md *.json *.csv *.png *.pdf *.gif *.npz
recursive-exclude example progress_*.json
recursive-include tests *.py *.json
include CONTRIBUTING.md
recursive-include tools *.py *.md
prune archive
prune tools/validation/outputs
global-exclude __pycache__ *.py[cod] .DS_Store
